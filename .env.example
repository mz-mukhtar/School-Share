APP_NAME="SchoolShare"
# Upgrade-notification recipient. The fresh installer sets this to its admin email.
SCHOOLSHARE_ADMIN_EMAIL=mahizeki037@gmail.com
# Development defaults. For production use the configuration in SELF_HOSTING.md:
# APP_ENV=production, APP_DEBUG=false, APP_URL=https://your-domain.example.
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=schoolshare
DB_USERNAME=root
DB_PASSWORD=

# File Upload Limits
SCHOOLSHARE_MAX_FILE_MB=100
# Compatibility/default configuration. Per-account storage enforcement currently
# follows the plan settings in config/schoolshare.php; do not treat this value
# alone as the authoritative user quota until that policy is consolidated.
SCHOOLSHARE_MAX_STORAGE_GB=3
# Operational alert threshold; does not replace per-plan quotas.
SCHOOLSHARE_MINIMUM_FREE_MB=100

# License Key (leave blank for Community Edition — EthioNext branding will be shown)
# Purchase a Commercial License at: https://ethionext.com.et/pricing
# Contact: mahizeki037@gmail.com | +251 992 194 042
SCHOOLSHARE_LICENSE_KEY=

# Branding Mode: "community" (default) or "whitelabel" (requires valid license key)
SCHOOLSHARE_BRANDING_MODE=community

# Development mail is logged and does not reach a mailbox.
# Production: MAIL_MAILER=smtp, provider credentials, and a verified sender.
# Use MAIL_SCHEME=smtps with port 465, or smtp with port 587 (STARTTLS).
# MAIL_URL is an optional DSN and overrides individual SMTP connection values.
# MAIL_ENCRYPTION is not read by this application's mail configuration.
MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_SCHEME=null
MAIL_URL=null
MAIL_FROM_ADDRESS="noreply@ethionext.com.et"
MAIL_FROM_NAME="${APP_NAME}"

# Session
SESSION_DRIVER=file
SESSION_LIFETIME=120
# Enable SESSION_SECURE_COOKIE=true in production after HTTPS/proxy verification.
SESSION_SECURE_COOKIE=null

# Persistent file cache for the supported single host; never use array/null
# or an in-memory failover for production rate limiting.
CACHE_STORE=file

# Delivery is synchronous. Database/Redis queues require managed workers first.
QUEUE_CONNECTION=sync

# Project operations explicitly use the private local disk. Keep storage/
# persistent across releases; changing FILESYSTEM_DISK alone does not enable S3.
FILESYSTEM_DISK=local
